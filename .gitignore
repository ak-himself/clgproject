# Large/private dataset files: keep dataset instructions/manifests, not image corpora
/data/raw/*
!/data/raw/README.md
/data/processed/realwaste/
/datasets/
/dataset/
/garbage_dataset/
/trashnet/
/trashnet-*/
*.zip
*.tar
*.tar.gz
*.7z

# Trained model checkpoints are intentionally versioned for reproducibility.
# Keep model metadata, checkpoints, evaluation metrics and confusion matrices in Git.
# Ignore only unrelated/temporary model exports:
saved_models/
checkpoints/
*.weights.h5
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.ckpt

# Local temporary outputs and logs (tracked reports/ are intentionally allowed)
runs/
outputs/
logs/
*.log
*.parquet

# TensorFlow / Keras caches
.keras/
.tensorflow/
